# Acceso privado al panel web
ADMIN_EMAIL=tu-email@ejemplo.com
ADMIN_PASSWORD=cambiar-por-una-clave-segura
SESSION_SECRET=generar-un-secreto-largo-y-aleatorio

# Login de Brio (solo servidor)
USERNAME=tu-usuario-de-brio
PASSWORD=tu-clave-de-brio
# Opcional: fallback manual. El backend obtiene un token fresco automáticamente.
BRIO_TOKEN=

# Configuración Brio/Neptunia
BRIO_SOCIO_ID=tu-id-de-socio
BRIO_SEDE_ID=4
BRIO_TIPO_SERVICIO_ID=1
BRIO_HORA_DESDE=7
BRIO_HORA_HASTA=23
BRIO_BASE_URL=https://neptunia.brio.club

# Alternativa opcional al login automático: cookie completa ya autenticada.
# Ejemplo: csrftoken=...; sessionid=...
BRIO_COOKIE=
