# Acceso privado al panel web
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-por-una-clave-segura
SESSION_SECRET=generar-un-secreto-largo-y-aleatorio

# Opcional: solo para el monitor automático de alertas.
# La navegación y las reservas usan el segundo login dentro del sitio.
USERNAME=
PASSWORD=

# Alertas por email (secretos de integraciones)
# Las crea automáticamente la integración "Upstash for Redis" de Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
CRON_SECRET=

# Clave aleatoria exclusiva para cifrar las credenciales de Brio usadas por automatizaciones.
AUTOMATION_ENCRYPTION_KEY=
